{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "sample_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "tool": {
      "enum": [
        "bandit",
        "ast",
        "pytest-docker"
      ]
    },
    "tool_version": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "code_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "not_run",
        "completed",
        "error"
      ]
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "completed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "cwe": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high",
              "unknown"
            ]
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high",
              "unknown"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "rule_id",
          "cwe",
          "severity",
          "confidence",
          "message",
          "line",
          "evidence"
        ]
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "test_id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "functional",
              "security"
            ]
          },
          "outcome": {
            "enum": [
              "passed",
              "failed",
              "error",
              "skipped"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "test_id",
          "category",
          "outcome",
          "message"
        ]
      }
    },
    "evidence_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "message"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "sample_id",
    "tool",
    "tool_version",
    "code_sha256",
    "status",
    "started_at",
    "completed_at",
    "findings",
    "tests",
    "evidence_files",
    "error",
    "notes"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "not_run"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "maxItems": 0
          },
          "tests": {
            "maxItems": 0
          },
          "started_at": {
            "type": "null"
          },
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          },
          "tool_version": {
            "type": "string",
            "minLength": 1
          },
          "evidence_files": {
            "minItems": 1
          },
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "object"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
