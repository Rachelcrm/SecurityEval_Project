{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "sample_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "cwe": {
      "type": "string",
      "pattern": "^CWE-[0-9]+$"
    },
    "entry_point": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "signature": {
      "type": "string",
      "minLength": 1
    },
    "selection_reason": {
      "type": "string",
      "minLength": 1
    },
    "modifications": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "adapted_prompt": {
      "type": "string",
      "minLength": 1
    },
    "original_prompt": {
      "type": "string",
      "minLength": 1
    },
    "functional_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "security_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "dataset_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "repository",
        "revision",
        "file",
        "record_id",
        "url",
        "dataset_sha256",
        "prompt_sha256"
      ]
    }
  },
  "required": [
    "schema_version",
    "sample_id",
    "cwe",
    "entry_point",
    "signature",
    "selection_reason",
    "modifications",
    "adapted_prompt",
    "original_prompt",
    "functional_requirements",
    "security_requirements",
    "source"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
